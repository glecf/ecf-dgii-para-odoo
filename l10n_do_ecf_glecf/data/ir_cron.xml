<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: an administrator who switches the job off (or changes how
         often it runs) keeps that after updating the module. -->
    <data noupdate="1">
        <record id="ir_cron_glecf_sync" model="ir.cron">
            <field name="name">e-CF: enviar a GLECF, traer los recibidos y leer las respuestas de la DGII</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_glecf_sync()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
