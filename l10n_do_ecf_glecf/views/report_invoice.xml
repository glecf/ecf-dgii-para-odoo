<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- What the DGII asks of the printed e-CF (Informe Técnico e-CF, 18.2.3)
         that the l10n_do_accounting template leaves short:
         - a QR of at least 22 x 22 mm, starting 2 cm or more from the edge of
           the sheet, that a phone can read: the long DGII link does not fit
           legibly in a 100 px image once printed. The PDF renders about 15%
           smaller than the CSS asks, hence 29 mm and 13 mm;
         - the signing date with its time, in Dominican time;
         - the text under the QR, smaller than the invoice body (Jorge,
           2026-10-29). -->
    <template id="report_invoice_document_ecf"
              inherit_id="l10n_do_accounting.report_invoice_document_inherited">
        <xpath expr="//img[contains(@t-att-src, 'barcode_type=QR')]" position="attributes">
            <attribute name="t-att-src">'/report/barcode/?barcode_type=QR&amp;width=400&amp;height=400&amp;value=' + o.l10n_do_electronic_stamp</attribute>
            <attribute name="style">width: 29mm; height: 29mm;</attribute>
        </xpath>
        <xpath expr="//img[contains(@t-att-src, 'barcode_type=QR')]/../.." position="attributes">
            <attribute name="style" add="padding-left: 13mm; font-size: 9pt; line-height: 1.3" separator=";"/>
        </xpath>
        <xpath expr="//t[@t-if='o.l10n_do_ecf_sign_date']/span" position="attributes">
            <attribute name="t-out">o._glecf_sign_date_text()</attribute>
        </xpath>
        <!-- Amounts and labels of the totals follow this language too, and they
             came out in English with a contact in English (2026-10-30). -->
        <xpath expr="//t[@t-set='o'][1]" position="before">
            <t t-set="lang" t-value="o._glecf_report_lang() or lang"/>
        </xpath>
        <!-- The last line break of the template pushed a blank second page when
             the invoice just fills the first one (2026-10-30). -->
        <xpath expr="//div[@id='right-elements']/../following-sibling::br[1]" position="replace"/>
        <xpath expr="//span[@id='line_tax_ids']" position="attributes">
            <attribute name="t-out">', '.join(tax.name for tax in line.tax_ids) if not ecf_representation else '%s %s' % (o.currency_id.symbol, '{0:,.2f}'.format(o._glecf_line_itbis(line)))</attribute>
        </xpath>
        <!-- A line prints what goes to the DGII: without ITBIS, also with
             «Impuestos incl.», and a minor expense with the ITBIS inside. -->
        <xpath expr="//span[@t-field='line.price_unit']" position="replace">
            <t t-if="not o._glecf_printed_type()">$0</t>
            <span t-if="o._glecf_printed_type() and not hide_prices" class="text-nowrap"
                  t-out="o._glecf_line_unit_price(line)"
                  t-options="{'widget': 'float', 'decimal_precision': 'Product Price'}"/>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <t t-if="not o._glecf_printed_type()">$0</t>
            <span t-if="o._glecf_printed_type() and not hide_prices" class="text-nowrap"
                  t-out="o._glecf_line_amount(line)"
                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
        </xpath>
        <xpath expr="//span[@t-field='line.price_total']" position="attributes">
            <attribute name="t-if">not o._glecf_printed_type() and not hide_prices and o.company_price_include == 'tax_included'</attribute>
        </xpath>
    </template>

    <!-- After the withholdings, what is actually paid (2026-10-30).
         o_total paints the row in the Boxed layout, and the amounts of this
         table came out dark on dark, unreadable. -->
    <template id="document_tax_totals_ecf" inherit_id="l10n_do_accounting.document_tax_totals">
        <!-- The amounts sent to the DGII, not the ones of the invoice taxes
             (2026-11-01). A minor expense has no ITBIS in its e-CF. -->
        <xpath expr="//tr[hasclass('o_subtotal')]//span" position="replace">
            <t t-if="o._glecf_printed_type() != '43'">$0</t>
            <span t-else="" class="text-nowrap" t-out="o._glecf_report_amounts()['exempt']"
                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
        </xpath>
        <xpath expr="//tr[@t-if='tax_aml.tax_line_id.amount > 0']" position="attributes">
            <attribute name="t-if">tax_aml.tax_line_id.amount > 0 and o._glecf_printed_type() != '43'</attribute>
        </xpath>
        <xpath expr="//t[@t-set='total_exempt_amount']" position="after">
            <t t-set="total_amount_taxed" t-value="o._glecf_report_amounts()['taxed']"/>
            <t t-set="total_exempt_amount" t-value="o._glecf_report_amounts()['exempt']"/>
        </xpath>
        <xpath expr="//tr[td[normalize-space()='Monto Gravado']]" position="attributes">
            <attribute name="class" remove="o_total" separator=" "/>
        </xpath>
        <xpath expr="//tr[td/strong[normalize-space()='Total']]" position="attributes">
            <attribute name="class" remove="o_total" separator=" "/>
        </xpath>
        <xpath expr="." position="inside">
            <tr class="border-black" t-if="o.line_ids.filtered(lambda line: line.tax_line_id.amount &lt; 0)">
                <td><strong>Total a pagar</strong></td>
                <td class="text-end">
                    <span class="text-nowrap" t-out="o.amount_total"
                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                </td>
            </tr>
        </xpath>
    </template>

    <!-- Printed in Spanish whatever the language of the contact. -->
    <template id="report_invoice_ecf" inherit_id="l10n_do_accounting.report_invoice">
        <xpath expr="//t[@t-call='l10n_do_accounting.report_invoice_document_inherited']" position="attributes">
            <attribute name="t-lang">o._glecf_report_lang() or lang</attribute>
        </xpath>
    </template>
</odoo>
