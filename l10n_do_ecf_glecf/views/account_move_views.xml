<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_glecf" model="ir.ui.view">
        <field name="name">account.move.form.glecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_draft']" position="before">
                <button name="action_glecf_send" type="object" string="Enviar a la DGII"
                        class="btn-primary"
                        invisible="state != 'posted' or glecf_state not in ('to_send', 'error') or (glecf_state == 'to_send' and glecf_auto_send and glecf_consent)"
                        groups="account.group_account_invoice"/>
                <button name="action_glecf_retry" type="object" string="Reintentar envío"
                        class="btn-primary"
                        invisible="glecf_state != 'review' or not glecf_retryable"
                        groups="account.group_account_invoice"/>
                <button name="action_glecf_correct" type="object" string="Corregir la factura"
                        class="btn-primary"
                        invisible="state != 'posted' or glecf_state != 'rejected' or not glecf_ncf_reusable"
                        groups="account.group_account_invoice"/>
                <button name="action_glecf_refresh" type="object" string="Ver respuesta de la DGII"
                        invisible="glecf_state != 'sent'"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//sheet/*[1]" position="before">
                <field name="glecf_refund_missing_tax" invisible="1"/>
                <field name="glecf_consent" invisible="1"/>
                <field name="glecf_will_send" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not glecf_will_send">
                    Al confirmar, este documento se enviará a la DGII como e-CF.
                    Ya aceptado no se puede borrar: se corrige con una nota de crédito o de débito.
                </div>
                <!-- In the system, not on the printed invoice (Jorge, 2026-10-30). -->
                <div class="alert alert-warning" role="alert"
                     invisible="state != 'posted' or glecf_state not in ('error', 'rejected', 'review')">
                    Este e-CF no está aceptado por la DGII: no tiene valor fiscal.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="state != 'posted' or glecf_state != 'to_send' or glecf_consent">
                    Este e-CF no saldrá a la DGII hasta que aceptes «Datos que se envían a GLECF»
                    en Ajustes &gt; Facturación.
                </div>
                <div class="alert alert-warning d-flex align-items-center gap-3" role="alert"
                     invisible="state != 'draft' or not glecf_refund_missing_tax">
                    <span>La factura original lleva ITBIS y esta nota de crédito no. Si devuelves parte
                        de lo facturado, el ITBIS también se devuelve.</span>
                    <button name="action_glecf_add_origin_tax" type="object"
                            string="Añadir el ITBIS de la factura original" class="btn btn-warning btn-sm"/>
                </div>
            </xpath>
            <!-- Placeholder from Odoo says «RFC» in Spanish. -->
            <xpath expr="//field[@name='partner_id'][@widget='res_partner_many2one']" position="attributes">
                <attribute name="placeholder">Buscar nombre o RNC...</attribute>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="after">
                <!-- Without this field on the form, the number typed for the first
                     e-NCF was lost as soon as the date changed: the browser never
                     sent it back to the server (2026-10-30). -->
                <field name="l10n_do_fiscal_number" invisible="1"/>
                <field name="glecf_state" widget="badge"
                       invisible="not glecf_state"
                       decoration-info="glecf_state in ('to_send', 'sent')"
                       decoration-success="glecf_state == 'accepted'"
                       decoration-warning="glecf_state == 'conditional'"
                       decoration-danger="glecf_state in ('rejected', 'error', 'review')"/>
                <field name="glecf_remote_status" invisible="1"/>
                <field name="glecf_retryable" invisible="1"/>
                <field name="glecf_auto_send" invisible="1"/>
                <field name="glecf_ncf_reusable" invisible="1"/>
                <field name="glecf_message" invisible="not glecf_message"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_glecf" model="ir.ui.view">
        <field name="name">account.move.tree.glecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="glecf_state" widget="badge" optional="show"
                       decoration-info="glecf_state in ('to_send', 'sent')"
                       decoration-success="glecf_state == 'accepted'"
                       decoration-warning="glecf_state == 'conditional'"
                       decoration-danger="glecf_state in ('rejected', 'error', 'review')"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_glecf" model="ir.ui.view">
        <field name="name">account.move.search.glecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='draft']" position="before">
                <filter name="glecf_attention" string="e-CF por revisar"
                        domain="[('glecf_state', 'in', ('error', 'rejected', 'conditional', 'review'))]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="action_glecf_send_selected" model="ir.actions.server">
        <field name="name">Enviar e-CF a la DGII</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_glecf_send()</field>
    </record>
</odoo>
