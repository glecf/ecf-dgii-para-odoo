<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_glecf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.glecf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="before">
                <block title="Electronic invoicing (e-CF)" id="glecf_settings">
                    <setting id="glecf_connection" string="GLECF connection"
                             help="GLECF signs your e-CF with your certificate and sends them to the DGII.">
                        <div class="mt8" invisible="glecf_api_key">
                            <button name="action_glecf_connect" type="object"
                                    string="Connect to GLECF" class="btn-primary"/>
                            <div class="mt8 text-muted">
                                No account yet?
                                <button name="action_glecf_create_account" type="object"
                                        string="Create a free GLECF account" class="btn-link p-0 align-baseline"/>
                            </div>
                        </div>
                        <div class="row" invisible="not glecf_account_name">
                            <label for="glecf_account_name" string="GLECF account" class="col-lg-3 o_light_label"/>
                            <div class="col">
                                <field name="glecf_account_name" class="oe_inline"/>
                                <span class="text-muted"> · RNC </span>
                                <field name="glecf_account_rnc" class="oe_inline"/>
                            </div>
                        </div>
                        <div class="row">
                            <label for="l10n_do_ecf_service_env" string="DGII environment" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_ecf_service_env"/>
                        </div>
                        <div invisible="not glecf_api_key">
                            <button name="action_glecf_check_connection" type="object"
                                    string="Check connection" class="btn-link ps-0"
                                    icon="oi-arrow-right"/>
                            <button name="action_glecf_connect" type="object"
                                    string="Connect again" class="btn-link"/>
                        </div>
                        <div class="row mt16">
                            <label for="glecf_api_key" string="API key" class="col-lg-3 o_light_label"/>
                            <div class="col">
                                <field name="glecf_api_key" password="True" placeholder="glecf_..."/>
                                <div class="text-muted small" invisible="glecf_api_key">
                                    Or paste one by hand:
                                    <a href="https://app.glecf.com/ecf/api-keys" target="_blank">Get your API key</a>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="glecf_certificate" string="Digital certificate"
                             help="GLECF signs your e-CF with it. The file and its password are kept by GLECF, not by Odoo."
                             invisible="not glecf_api_key">
                        <div class="mt8" invisible="not glecf_certificate_name">
                            <field name="glecf_certificate_name" class="fw-bold"/>
                            <span class="text-muted"> · valid until </span>
                            <field name="glecf_certificate_valid_until"/>
                        </div>
                        <div class="mt8 text-muted" invisible="glecf_certificate_name">
                            No certificate yet.
                        </div>
                        <button name="%(l10n_do_ecf_glecf.action_glecf_certificate_wizard)d" type="action"
                                string="Upload certificate" class="btn-link ps-0" icon="oi-arrow-right"/>
                    </setting>
                    <setting id="glecf_consent" string="Data sent to GLECF"
                             help="When an e-CF is sent, its number, dates, amounts, lines and the data of your company and customer go to GLECF, which keeps them to deliver them to the DGII.">
                        <field name="glecf_consent"/>
                        <div class="mt8">
                            <a href="https://glecf.com/legal#privacidad" target="_blank">Privacy policy</a>
                            <span class="text-muted"> · </span>
                            <a href="https://glecf.com/legal#terminos" target="_blank">Terms of service</a>
                        </div>
                    </setting>
                    <setting id="glecf_auto_send" string="Send when posting"
                             help="Each e-CF is sent a moment after it is posted. Otherwise, use Send to DGII on the invoice.">
                        <field name="glecf_auto_send"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
