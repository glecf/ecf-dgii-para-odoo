<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_glecf" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.glecf</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="before">
                <block title="Facturación electrónica (e-CF)" id="glecf_settings">
                    <setting id="glecf_connection" string="Conexión con GLECF"
                             help="GLECF firma tus e-CF con tu certificado y los envía a la DGII.">
                        <img src="/l10n_do_ecf_glecf/static/src/img/logo-glecf.svg" alt="GLECF"
                             class="mt8 mb8" style="height: 28px;"/>
                        <div class="mt8" invisible="glecf_api_key">
                            <button name="action_glecf_connect" type="object"
                                    string="Conectar con GLECF" class="btn-primary"/>
                            <div class="mt8 text-muted">
                                ¿Aún no tienes cuenta?
                                <button name="action_glecf_create_account" type="object"
                                        string="Crear una cuenta gratis en GLECF" class="btn-link p-0 align-baseline"/>
                            </div>
                        </div>
                        <div class="row" invisible="not glecf_account_name">
                            <label for="glecf_account_name" string="Cuenta de GLECF" class="col-lg-3 o_light_label"/>
                            <div class="col">
                                <field name="glecf_account_name" class="oe_inline"/>
                                <span class="text-muted"> · RNC </span>
                                <field name="glecf_account_rnc" class="oe_inline"/>
                            </div>
                        </div>
                        <field name="glecf_plan_low" invisible="1"/>
                        <div class="mt8" invisible="not glecf_plan_summary">
                            <field name="glecf_plan_summary" class="oe_inline"
                                   decoration-warning="glecf_plan_low"/>
                            <a href="https://app.glecf.com/cuenta" target="_blank" class="ms-2"
                               invisible="not glecf_plan_low">Mejorar el plan</a>
                        </div>
                        <div class="row">
                            <label for="l10n_do_ecf_service_env" string="Ambiente de la DGII" class="col-lg-3 o_light_label"/>
                            <field name="l10n_do_ecf_service_env"/>
                        </div>
                        <div invisible="not glecf_api_key">
                            <button name="action_glecf_check_connection" type="object"
                                    string="Comprobar conexión" class="btn-link ps-0"
                                    icon="oi-arrow-right"/>
                            <button name="action_glecf_connect" type="object"
                                    string="Volver a conectar" class="btn-link"/>
                        </div>
                        <div class="row mt16">
                            <label for="glecf_api_key" string="Clave de API" class="col-lg-3 o_light_label"/>
                            <div class="col">
                                <field name="glecf_api_key" password="True" placeholder="glecf_..."/>
                                <div class="text-muted small" invisible="glecf_api_key">
                                    O pégala a mano:
                                    <a href="https://app.glecf.com/ecf/api-keys" target="_blank">Obtener tu clave de API</a>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="glecf_certificate" string="Certificado digital"
                             help="GLECF firma tus e-CF con él. El archivo y su contraseña los guarda GLECF, no Odoo."
                             invisible="not glecf_api_key">
                        <div class="mt8" invisible="not glecf_certificate_name">
                            <field name="glecf_certificate_name" class="fw-bold"/>
                            <span class="text-muted"> · válido hasta </span>
                            <field name="glecf_certificate_valid_until"/>
                        </div>
                        <div class="mt8 text-muted" invisible="glecf_certificate_name">
                            Todavía no hay certificado.
                        </div>
                        <button name="%(l10n_do_ecf_glecf.action_glecf_certificate_wizard)d" type="action"
                                string="Subir certificado" class="btn-link ps-0" icon="oi-arrow-right"/>
                    </setting>
                    <setting id="glecf_sequences" string="Secuencias e-NCF"
                             help="Cada tipo de e-CF usa la secuencia que autorizó la DGII. Aquí va su fecha de vencimiento; el primer número se escribe en la primera factura de cada tipo y Odoo sigue desde ahí.">
                        <div class="mt8 text-warning" invisible="not glecf_sequences_to_check">
                            <field name="glecf_sequences_to_check" class="oe_inline"/>
                            secuencias tienen todavía la fecha de vencimiento que puso Odoo. Compruébala con tu autorización de la DGII.
                        </div>
                        <button name="action_glecf_sequences" type="object"
                                string="Configurar las secuencias e-NCF" class="btn-link ps-0" icon="oi-arrow-right"/>
                    </setting>
                    <setting id="glecf_consent" string="Datos que se envían a GLECF"
                             help="Al enviar un e-CF, su número, fechas, importes, líneas y los datos de tu empresa y de tu cliente van a GLECF, que los guarda para entregarlos a la DGII.">
                        <field name="glecf_consent"/>
                        <div class="mt8">
                            <a href="https://glecf.com/legal#privacidad" target="_blank">Política de privacidad</a>
                            <span class="text-muted"> · </span>
                            <a href="https://glecf.com/legal#terminos" target="_blank">Términos del servicio</a>
                        </div>
                    </setting>
                    <setting id="glecf_auto_send" string="Enviar al publicar"
                             help="Cada e-CF se envía un momento después de publicarlo. Si no, usa «Enviar a la DGII» en la factura.">
                        <field name="glecf_auto_send"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
