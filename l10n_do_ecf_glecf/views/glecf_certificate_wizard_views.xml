<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="glecf_certificate_wizard_form" model="ir.ui.view">
        <field name="name">glecf.certificate.wizard.form</field>
        <field name="model">glecf.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload certificate">
                <p class="text-muted">
                    The certificate goes straight to GLECF, which keeps it encrypted and signs your e-CF with it.
                    Odoo does not keep the file or the password.
                </p>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="certificate_file" filename="certificate_filename" required="1"/>
                    <field name="certificate_filename" invisible="1"/>
                    <field name="certificate_password" password="True"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload to GLECF" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_glecf_certificate_wizard" model="ir.actions.act_window">
        <field name="name">Upload certificate</field>
        <field name="res_model">glecf.certificate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
