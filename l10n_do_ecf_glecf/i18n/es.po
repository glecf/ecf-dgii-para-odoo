msgstr "%(doc)s: este módulo todavía no envía el tipo de e-CF %(type)s."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
