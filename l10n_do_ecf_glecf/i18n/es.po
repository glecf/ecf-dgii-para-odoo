#, python-format
msgid ""
"%(doc)s: line «%(line)s» must have a single ITBIS of 18%% or 16%%, or none."
msgstr "%(doc)s: la línea «%(line)s» debe llevar un solo ITBIS, del 18%% o del 16%%, o ninguno."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
