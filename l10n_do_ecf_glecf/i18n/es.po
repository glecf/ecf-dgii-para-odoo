msgstr "%(doc)s: el cliente %(name)s necesita un RNC (9 dígitos) o una cédula (11 dígitos) válidos."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid ""
"%(doc)s: the e-CF total (%(ecf)s) does not match the invoice total "
"(%(odoo)s). This version only supports ITBIS 18%%, ITBIS 16%% and exempt "
"lines."
msgstr "%(doc)s: el total del e-CF (%(ecf)s) no cuadra con el de la factura (%(odoo)s). Esta versión solo admite ITBIS 18%%, ITBIS 16%% y líneas exentas."

