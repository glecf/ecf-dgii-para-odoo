#, python-format
msgid ""
"%(doc)s: a special regime invoice (E44) cannot charge ITBIS (line "
"«%(line)s»)."
msgstr ""
"%(doc)s: una factura de régimen especial (E44) no puede cobrar ITBIS (línea "
"«%(line)s»)."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
