msgstr "%(doc)s: la línea «%(line)s» tiene un descuento del 100%%."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid ""
"%(doc)s: line «%(line)s» has taxes other than ITBIS (%(taxes)s). This "
"version does not send withholdings or selective taxes yet."
msgstr ""
"%(doc)s: la línea «%(line)s» tiene impuestos que no son ITBIS (%(taxes)s). "
"Esta versión todavía no envía retenciones ni impuestos selectivos."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid ""
"%(doc)s: line «%(line)s» must have a single ITBIS of 18%% or 16%%, or none."
msgstr ""
"%(doc)s: la línea «%(line)s» debe llevar un solo ITBIS, del 18%% o del 16%%,"
" o ninguno."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid "%(doc)s: line «%(line)s» needs a positive quantity."
msgstr "%(doc)s: la línea «%(line)s» necesita una cantidad mayor que cero."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid ""
"%(doc)s: the customer %(name)s needs a valid RNC (9 digits) or cédula (11 "
"digits)."
msgstr ""
"%(doc)s: el cliente %(name)s necesita un RNC (9 dígitos) o una cédula (11 "
"dígitos) válidos."

#. module: l10n_do_ecf_glecf
#. odoo-python
#: code:addons/l10n_do_ecf_glecf/models/ecf_builder.py:0
#, python-format
msgid ""
"%(doc)s: the e-CF total (%(ecf)s) does not match the invoice total "
"(%(odoo)s). This version only supports ITBIS 18%%, ITBIS 16%% and exempt "
"lines."
msgstr ""
"%(doc)s: el total del e-CF (%(ecf)s) no cuadra con el de la factura "
"(%(odoo)s). Esta versión solo admite ITBIS 18%%, ITBIS 16%% y líneas "
"exentas."

